# =============================================================================
# FireCode Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -------------------------
# Database
# -------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/firecode

# -------------------------
# Redis (BullMQ + Cache)
# -------------------------
REDIS_URL=redis://127.0.0.1:6379

# -------------------------
# JWT Secrets
# CRITICAL: Use long, random, independent secrets for each.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -------------------------
ACCESS_TOKEN_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_BYTE_HEX_STRING
REFRESH_TOKEN_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_64_BYTE_HEX_STRING

# -------------------------
# App URLs
# -------------------------
FRONTEND_URL=http://localhost:5173
# PORT defaults to 80 in server.ts if not set
PORT=80

# -------------------------
# Judge0 Code Execution Engine
# For local dev / tunnel: https://limitations-str-licence-louisville.trycloudflare.com or http://127.0.0.1:2358
# For Oracle Cloud Always Free VPS: http://<YOUR_ORACLE_VM_PUBLIC_IP>:2358
# For RapidAPI hosted Judge0: https://judge0-ce.p.rapidapi.com
# -------------------------
JUDGE0_URL=https://limitations-str-licence-louisville.trycloudflare.com
# Optional API Key (required only if using RapidAPI or authenticated Judge0)
JUDGE0_KEY=

# -------------------------
# Node Environment
# Options: development | production | test
# -------------------------
NODE_ENV=development

# -------------------------
# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# -------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:80/api/accounts/auth/google/callback

# -------------------------
# GitHub OAuth
# Create OAuth App at: https://github.com/settings/developers
# -------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:80/api/accounts/auth/github/callback

# -------------------------
# Email Provider (for password reset)
# TODO: Wire up a transactional email provider below.
# Options: SendGrid, Resend, AWS SES, nodemailer + SMTP
# -------------------------
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@firecode.dev
