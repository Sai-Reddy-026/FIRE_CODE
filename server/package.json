        "@types/bad-words": "^3.0.3",
        "@types/bcrypt": "^5.0.2",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.97",
        "@types/node": "^20.4.4",
        "adm-zip": "^0.6.0",
        "axios": "^1.18.1",
